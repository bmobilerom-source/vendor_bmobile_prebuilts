// Local NLP Backend — optional offline RF location module for microG (GPLv3)
// https://f-droid.org/en/packages/helium314.localbackend/
// Note: GmsCore 0.3.x primarily uses built-in MLS (see /system/etc/microg.xml).
prebuilt_etc {
    name: "default-permissions-helium314.localbackend.xml",
    src: "localbackend/default-permissions-helium314.localbackend.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

android_app_import {
    name: "LocalNLPBackend",
    apk: "localbackend/helium314.localbackend_43.apk",
    privileged: false,
    presigned: true,
    preprocessed: true,
    required: [
        "default-permissions-helium314.localbackend.xml",
    ],
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}
