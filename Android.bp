// Local NLP Backend — optional offline RF location module for microG (GPLv3)
// https://f-droid.org/en/packages/helium314.localbackend/
// Note: GmsCore 0.3.x primarily uses built-in MLS (see /system/etc/microg.xml).
prebuilt_etc {
    name: "default-permissions-helium314.localbackend.xml",
    src: "localbackend/default-permissions-helium314.localbackend.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

android_app_import {
    name: "LocalNLPBackend",
    apk: "localbackend/helium314.localbackend_43.apk",
    privileged: false,
    presigned: true,
    preprocessed: true,
    required: [
        "default-permissions-helium314.localbackend.xml",
    ],
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

// Snes9x EX+ — SNES emulator (GPLv3 frontend; SNES9x core non-commercial)
// https://github.com/Rakashazi/emu-ex-plus-alpha/releases
// Platform-signed so Soong can uncompress JNI (upstream APK has compressed .so).
android_app_import {
    name: "Snes9xEXPlus",
    apk: "snes9x/Snes9xEXPlus.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
    privileged: false,
}

// DigiPaws — simpler KidsSafe digital wellness / screen-time (v2.3-alpha-lite)
// Package: nethical.digipaws — APK retained after Reef was unpackaged (CE prefs RescueParty).
// Upstream digipaws discontinued → Curbox; keep v23 for young-user UX simplicity.
// SHA256: d3ec35d3a05fa51635698937e134e801e5d06b33d5b18f7245c9c6d46abe806b
android_app_import {
    name: "Digipaws",
    apk: "digipaws/nethical.digipaws_23.apk",
    presigned: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
    privileged: false,
}

